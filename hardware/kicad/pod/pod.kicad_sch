  (text "Active dry-electrode pod: 2 x 10 mm ENIG electrodes, 20 mm IED, OPA2376 buffers"
    (at 20 25 0)
    (effects
      (font (size 2.5 2.5))
      (justify left bottom)
    )
    (uuid "cc8ba20d-416f-5c37-a4f1-3540f1dd7d06")
  )
  (text "Electrodes E1/E2 are bare ENIG pads on the PCB bottom (skin side), 20 mm centre-to-centre (SENIAM).\nR1/R2 (100k) limit current into the body to < 33 uA under any single fault (3.3 V across 100k).\nBuffer outputs also drive the solder-masked guard rings around each electrode (bootstrapped guard).\nR3/R4 isolate the op-amp outputs from cable capacitance. Body is biased to ~1.5 V by the hub RLD."
    (at 20 257 0)
    (effects
      (font (size 1.5 1.5))
      (justify left bottom)
    )
    (uuid "3ea1c96b-3987-5879-b129-3b166a5ed52f")
  )
  (sheet_instances
    (path "/" (page "1"))
  )
)
