(footprint "DryElectrode_D10mm" (version 20221018) (generator pcbnew)
  (layer "F.Cu")
  (descr "Dry sEMG skin electrode: 10 mm round ENIG pad, no paste, solder mask opened. Place on the skin side (flip to B.Cu). Specify ENIG or hard gold finish.")
  (tags "EMG electrode dry ENIG")
  (attr smd exclude_from_pos_files exclude_from_bom)
  (fp_text reference "REF**" (at 0 -6.5) (layer "F.SilkS") hide
    (effects (font (size 1 1) (thickness 0.15)))
  )
  (fp_text value "DryElectrode_D10mm" (at 0 6.5) (layer "F.Fab")
    (effects (font (size 1 1) (thickness 0.15)))
  )
  (fp_text user "${REFERENCE}" (at 0 0) (layer "F.Fab")
    (effects (font (size 1 1) (thickness 0.15)))
  )
  (fp_circle (center 0 0) (end 5 0) (layer "F.Fab") (stroke (width 0.1) (type solid)) (fill none))
  (fp_circle (center 0 0) (end 5.6 0) (layer "F.CrtYd") (stroke (width 0.05) (type solid)) (fill none))
  (pad "1" smd circle (at 0 0) (size 10 10) (layers "F.Cu" "F.Mask")
    (thermal_bridge_angle 45))
)
