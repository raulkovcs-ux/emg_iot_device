# Host build of the portable DSP/ML core (used by host/tests via ctypes).
#   make -f Makefile.host            -> build/libfama_dsp.so
CC ?= gcc
CFLAGS ?= -O2 -std=c11 -Wall -Wextra -Wpedantic -Wshadow -Wconversion -Wno-sign-conversion -Wdouble-promotion -fPIC -D_DEFAULT_SOURCE
SRC := src/dsp.c src/fama_net.c src/tier_b.c src/pipeline.c src/proto.c src/host_api.c

build/libfama_dsp.so: $(SRC) include/fama_dsp.h include/fama_coeffs.h include/fama_proto.h
	mkdir -p build
	$(CC) $(CFLAGS) -Iinclude -shared -o $@ $(SRC) -lm

clean:
	rm -rf build
